# Configuración de Entorno Cloud (AWS / GCP / Azure)
DEBUG=False
SECRET_KEY=entornoCloud1234
ALLOWED_HOSTS=autotrack-api.onrender.com,localhost,127.0.0.1

# Base de Datos Administrada (PaaS - ej. AWS RDS / Azure Database for MySQL / Cloud SQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=autotrack_db
DB_USER=admin_cloud
DB_PASSWORD=password_seguro_cloud
DB_HOST=autotrack-db.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306

# Orígenes CORS en Producción (Frontend estático en PaaS / SaaS)
CORS_ALLOWED_ORIGINS=https://autotrack-web.vercel.app,http://localhost:5173